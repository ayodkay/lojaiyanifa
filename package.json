{
  "name": "lojaiyanifa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "dev:emulated": "firebase emulators:exec --only firestore,auth --project demo-lojaiyanifa \"node scripts/dev/seed-emulator.mjs && react-router dev\"",
    "build": "react-router build && node scripts/build-functions.mjs",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "firebase --config firebase.test.json emulators:exec --only firestore,auth --project demo-lojaiyanifa \"vitest run --config vitest.integration.config.ts\"",
    "test:mail-live": "firebase --config firebase.test.json emulators:exec --only firestore,auth --project demo-lojaiyanifa \"vitest run --config vitest.mail-live.config.ts\"",
    "emulators": "firebase emulators:start --project demo-lojaiyanifa",
    "preview": "npm run build && firebase emulators:start --project demo-lojaiyanifa",
    "prismic:types": "prismic-ts-codegen",
    "prismic:pull": "node scripts/prismic/pull-models.mjs",
    "prismic:push": "node scripts/prismic/push-models.mjs"
  },
  "dependencies": {
    "@prismicio/client": "^7.23.0",
    "@prismicio/react": "^3.5.1",
    "@react-router/node": "^8.5.1",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "isbot": "^5.2.2",
    "minisearch": "^7.2.0",
    "nodemailer": "^10.3.1",
    "pix-utils": "^2.8.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.89.0",
    "prismic-ts-codegen": "^0.1.31",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    }
  }
}
