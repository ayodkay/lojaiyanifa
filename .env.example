# Copy to .env.local and fill in. .env.local is gitignored; never commit secrets.
# Variables are grouped by where they are used. "PUBLIC_" variables are exposed
# to the browser bundle; everything else is server-only.

# --- Site ---------------------------------------------------------------
# Public origin, no trailing slash. Production: https://<your domain>
SITE_URL=http://localhost:5173
# Require a second factor (TOTP) for admin sign-in. true in production.
ADMIN_REQUIRE_MFA=true

# --- Prismic (Settings > API & Security) -----------------------------------
PRISMIC_REPO=lojaiyanifa
PRISMIC_LOCALE=pt-br
# Write API token: scripts and admin-only server operations. Server-side only.
PRISMIC_WRITE_TOKEN=
# Content API token: only needed if the Content API is made private.
PRISMIC_ACCESS_TOKEN=

# --- Firebase (local development) -------------------------------------------
# Development and tests always use the emulators (Java 21+ required):
#   npm run emulators          Firestore, Auth, Functions, Hosting + UI on :4000
#   npm run test:integration   starts Firestore + Auth just for the test run
# Without these the server refuses to touch Firestore in development, so a dev
# machine can never write to a real project by accident. Leave them unset in
# production: Cloud Functions provides the project and credentials.
FIREBASE_PROJECT_ID=demo-lojaiyanifa
FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Firebase web app (browser sign-in for /admin) ---------------------------
# Firebase console > Project settings > Your apps > Web app config. Public
# values (they ship to the browser), but required in production. Leave empty
# locally: against the Auth emulator the API key is ignored. Not FIREBASE_*:
# the Firebase CLI reserves that prefix in a deployed function's environment.
WEB_API_KEY=
WEB_AUTH_DOMAIN=

# --- E-mail (Brevo SMTP relay) -------------------------------------------------
# Order e-mails are written to the Firestore `mail` outbox in the same
# transaction as the order change; the scheduled function sendMailOutbox sends
# them every 2 minutes. Without these, e-mails wait (and the function logs an
# error); after 72 hours they expire unsent.
# Sender: its domain must be verified in Brevo (Senders, domains & IPs).
MAIL_FROM=
# Optional: where replies go. Defaults to the support e-mail in Prismic settings.
MAIL_REPLY_TO=
# Optional: the store's own inbox for new-order notices (owner data: never commit it).
MAIL_STORE_TO=
# Brevo → SMTP & API → SMTP: server, port and login. 587 requires STARTTLS; 465 is TLS.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
# The SMTP key. Locally only, to try sending against a test server. In production
# it lives in Secret Manager, never in an env file:
#   firebase functions:secrets:set SMTP_PASSWORD --project prod
SMTP_PASSWORD=

# --- Production (deployed functions) ------------------------------------------
# Deployed functions don't read this file or .env.local. Their variables come
# from a gitignored file at the repo root named after the project:
# .env.lojaiyanifa. On every functions deploy, the predeploy hook
# (scripts/functions-env.mjs, see firebase.json) checks that file and copies it
# into build/functions/, where the Firebase CLI loads it.
# It must contain: SITE_URL (https origin), PRISMIC_REPO, PRISMIC_LOCALE,
# WEB_API_KEY, WEB_AUTH_DOMAIN and ADMIN_REQUIRE_MFA=true.
# Optional there: MAIL_FROM, MAIL_REPLY_TO, MAIL_STORE_TO, SMTP_HOST, SMTP_PORT,
# SMTP_USER (see "E-mail" above).
# It must not contain: emulator variables, GOOGLE_APPLICATION_CREDENTIALS or
# tokens (secrets go to Secret Manager: firebase functions:secrets:set NAME),
# nor SMTP_PASSWORD (a secret too).
# Deploy with: firebase deploy --only functions --project prod
